      left: 24px;
      top: 32px;
      bottom: 32px;
      width: 2px;
      background: #b6ded9;
    }

    .career-step {
      position: relative;
      display: grid;
      grid-template-columns: 50px 1fr;
      gap: 22px;
      align-items: start;
    }

    .career-dot {
      position: relative;
      z-index: 2;
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
