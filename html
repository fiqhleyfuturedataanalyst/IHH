      max-width: 760px;
    }

    .benefits-grid {
      margin-top: 56px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .benefit-card {
      position: relative;
      min-height: 330px;
      padding: 38px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--sand);
      border: 1px solid #ece8de;
    }

    .benefit-card:nth-child(4) {
      background: var(--navy);
    }

    .benefit-card:nth-child(4) h3,
    .benefit-card:nth-child(4) strong {
      color: white;
    }

    .benefit-card:nth-child(4) p,
    .benefit-card:nth-child(4) li {
      color: rgba(255,255,255,0.7);
    }

    .benefit-index {
      display: inline-grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: white;
      color: var(--teal-dark);
      font-weight: 850;
      font-size: 0.78rem;
      box-shadow: var(--shadow-sm);
    }

    .benefit-card h3 {
      margin-top: 52px;
      font-size: 1.5rem;
    }

