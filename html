<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="IHH Healthcare x Prince Court Medical Centre — New Employee Welcome Guide" />
  <title>IHH Healthcare × Prince Court | New Employee Welcome Guide</title>

  <!--
    ============================================================
    IHH HEALTHCARE × PRINCE COURT
    NEW EMPLOYEE WELCOME GUIDE

    DESIGN DIRECTION
    ------------------------------------------------------------
    Premium healthcare editorial / onboarding brochure.
    Replace the image paths in :root or the <img> elements with
    your approved official brand assets before final production.

    Suggested asset folder:
    assets/
      ihh-logo.svg
      prince-court-logo.svg
      prince-court-hero.jpg
      prince-court-building.jpg
      team-care.jpg
      staff-learning.jpg
      wellbeing.jpg
    ============================================================
  -->

  <style>
    /* =========================================================
       01. DESIGN TOKENS
       ========================================================= */

    :root {
      --ink: #152f36;
      --ink-soft: #52666b;
      --ink-faint: #74878b;

      --navy: #153b46;
      --navy-deep: #0d2e36;

      --teal: #009b9c;
      --teal-dark: #007d80;
      --teal-soft: #dff4f1;
      --teal-pale: #f0faf8;

      --green: #68ad45;
      --green-soft: #edf6e9;

      --purple: #7b5da7;
      --purple-soft: #f1edf7;

      --blue: #4089bd;
      --blue-soft: #eaf4fa;

      --coral: #e67762;
      --coral-soft: #fff0ed;

      --sand: #f7f4ed;
      --cream: #fbfaf7;
      --white: #ffffff;

      --line: #dbe5e4;
      --line-dark: rgba(21, 59, 70, 0.14);

      --shadow-sm: 0 8px 24px rgba(13, 46, 54, 0.08);
      --shadow-md: 0 18px 55px rgba(13, 46, 54, 0.12);
      --shadow-lg: 0 28px 80px rgba(13, 46, 54, 0.18);

      --radius-sm: 12px;
      --radius-md: 20px;
      --radius-lg: 32px;
      --radius-xl: 46px;

      --page: 1180px;
      --section-space: clamp(72px, 8vw, 128px);
    }

    /* =========================================================
       02. RESET + GLOBAL
       ========================================================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        "Aptos",
        "Helvetica Neue",
        Arial,
        sans-serif;
      color: var(--ink);
      background: var(--cream);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    img {
      display: block;
      width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    p {
      color: var(--ink-soft);
    }

    strong {
      color: var(--ink);
      font-weight: 750;
    }

    .container {
      width: min(calc(100% - 48px), var(--page));
      margin-inline: auto;
    }

    .section {
      position: relative;
      padding: var(--section-space) 0;
      overflow: hidden;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;

      color: var(--teal-dark);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 3px;
      border-radius: 999px;
      background: var(--teal);
    }

    h1,
    h2,
    h3,
    h4 {
      color: var(--navy-deep);
      line-height: 1.08;
      letter-spacing: -0.035em;
    }

    h1 {
      font-size: clamp(3.2rem, 7vw, 6.7rem);
      font-weight: 760;
    }

    h2 {
      font-size: clamp(2.25rem, 4.3vw, 4.35rem);
      font-weight: 730;
    }

    h3 {
      font-size: clamp(1.25rem, 2vw, 1.65rem);
      font-weight: 730;
    }

    .section-intro {
      max-width: 720px;
      margin-top: 22px;
      font-size: 1.08rem;
      line-height: 1.85;
    }

    .number {
      font-variant-numeric: tabular-nums;
    }

    /* =========================================================
       03. TOP BRAND BAR
       ========================================================= */

    .brand-bar {
      position: absolute;
      z-index: 20;
      top: 0;
      left: 0;
      width: 100%;
      padding: 30px 0;
    }

    .brand-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
    }

    .brand-lockup {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .brand-logo {
      height: 46px;
      width: auto;
      object-fit: contain;
    }

    .brand-logo--pcmc {
      height: 54px;
    }

    .brand-divider {
      width: 1px;
      height: 36px;
      background: rgba(255, 255, 255, 0.42);
    }

    .guide-label {
      color: rgba(255,255,255,0.82);
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    /* =========================================================
       04. HERO / COVER
       ========================================================= */

    .hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--navy-deep);
    }

    .hero-image {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(7, 35, 42, 0.93) 0%,
          rgba(7, 35, 42, 0.77) 38%,
          rgba(7, 35, 42, 0.25) 70%,
          rgba(7, 35, 42, 0.1) 100%
        ),
        linear-gradient(
          0deg,
          rgba(7, 35, 42, 0.72) 0%,
          rgba(7, 35, 42, 0) 50%
        ),
        url("prince-court-hero.jpg") center / cover no-repeat;
      transform: scale(1.01);
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -13vw;
      top: 7vh;
      width: 44vw;
      height: 44vw;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 50%;
      box-shadow:
        0 0 0 70px rgba(255,255,255,0.025),
        0 0 0 140px rgba(255,255,255,0.018);
    }

    .hero-content {
      position: relative;
      z-index: 4;
      padding: 210px 0 86px;
      width: 100%;
    }

    .hero-copy {
      max-width: 810px;
    }

    .hero-kicker {
      color: #8fe2da;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .hero h1 {
      color: white;
    }

    .hero h1 span {
      color: #a7e8df;
    }

    .hero-subtitle {
      max-width: 610px;
      margin-top: 26px;
      color: rgba(255,255,255,0.78);
      font-size: clamp(1.05rem, 1.8vw, 1.28rem);
      line-height: 1.75;
    }

    .hero-footer {
      margin-top: 70px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
    }

    .hero-purpose {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .hero-purpose-mark {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.22);
      color: white;
      font-size: 1.15rem;
    }

    .hero-purpose small {
      display: block;
      color: rgba(255,255,255,0.56);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-weight: 700;
      font-size: 0.64rem;
    }

    .hero-purpose strong {
      color: white;
      font-size: 0.96rem;
    }

    .edition {
      color: rgba(255,255,255,0.58);
      text-align: right;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* =========================================================
       05. WELCOME
       ========================================================= */

    .welcome {
      background: white;
    }

    .welcome-grid {
      display: grid;
      grid-template-columns: 0.92fr 1.08fr;
      gap: clamp(50px, 8vw, 110px);
      align-items: center;
    }

    .welcome-photo-wrap {
      position: relative;
    }

    .welcome-photo {
      height: 680px;
      object-fit: cover;
      border-radius: 0 var(--radius-xl) var(--radius-xl) var(--radius-xl);
      box-shadow: var(--shadow-lg);
    }

    .photo-tag {
      position: absolute;
      right: -28px;
      bottom: 42px;
      width: 210px;
      padding: 24px;
      background: var(--teal);
      color: white;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
    }

    .photo-tag .big {
      display: block;
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1;
    }

    .photo-tag .small {
      display: block;
      margin-top: 7px;
      font-size: 0.78rem;
      line-height: 1.45;
      opacity: 0.86;
    }

    .welcome-copy p {
      margin-top: 24px;
      font-size: 1.05rem;
      line-height: 1.9;
    }

    .quote-card {
      position: relative;
      margin-top: 42px;
      padding: 30px 34px;
      background: var(--teal-pale);
      border-left: 4px solid var(--teal);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }

    .quote-card .label {
      color: var(--teal-dark);
      font-size: 0.69rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .quote-card blockquote {
      margin-top: 8px;
      color: var(--navy);
      font-size: 1.5rem;
      line-height: 1.3;
      font-weight: 680;
      letter-spacing: -0.025em;
    }

    /* =========================================================
       06. PURPOSE / VISION
       ========================================================= */

    .purpose-section {
      background: var(--navy-deep);
      color: white;
    }

    .purpose-section .eyebrow {
      color: #95ddd6;
    }

    .purpose-section h2,
    .purpose-section h3 {
      color: white;
    }

    .purpose-section p {
      color: rgba(255,255,255,0.7);
    }

    .purpose-heading {
      max-width: 790px;
    }

    .purpose-heading h2 em {
      color: #9ee0d9;
      font-style: normal;
    }

    .purpose-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      margin-top: 58px;
    }

    .purpose-card {
      min-height: 300px;
      padding: 42px;
      border-radius: var(--radius-lg);
      border: 1px solid rgba(255,255,255,0.13);
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,0.09),
          rgba(255,255,255,0.025)
        );
      backdrop-filter: blur(10px);
    }

    .purpose-card-number {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-bottom: 58px;
      border-radius: 50%;
      background: #9ee0d9;
      color: var(--navy-deep);
      font-size: 0.75rem;
      font-weight: 900;
    }

    .purpose-card p {
      margin-top: 16px;
      max-width: 500px;
      line-height: 1.8;
    }

    /* =========================================================
       07. CORE VALUES
       ========================================================= */

    .values-section {
      background: var(--sand);
    }

    .values-header {
      display: grid;
      grid-template-columns: 1fr 0.8fr;
      gap: 80px;
      align-items: end;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
      margin-top: 58px;
    }

    .value-card {
      position: relative;
      min-height: 330px;
      padding: 30px 26px;
      background: white;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid rgba(13,46,54,0.06);
      transition: 0.25s ease;
    }

    .value-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
    }

    .value-card::after {
      content: "";
      position: absolute;
      right: -50px;
      bottom: -50px;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      background: var(--accent-soft);
    }

    .value-icon {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 1.45rem;
      margin-bottom: 74px;
    }

    .value-card h3 {
      font-size: 1.22rem;
    }

    .value-card p {
      margin-top: 9px;
      font-size: 0.88rem;
      line-height: 1.65;
    }

    .patients {
      --accent: var(--teal);
      --accent-soft: var(--teal-soft);
    }

    .integrity {
      --accent: var(--blue);
      --accent-soft: var(--blue-soft);
    }

    .empathy {
      --accent: var(--coral);
      --accent-soft: var(--coral-soft);
    }

    .teamwork {
      --accent: var(--purple);
      --accent-soft: var(--purple-soft);
    }

    .excellence {
      --accent: var(--green);
      --accent-soft: var(--green-soft);
    }

    .you-card {
      margin-top: 26px;
      display: grid;
      grid-template-columns: 0.45fr 1.55fr;
      gap: 35px;
      align-items: center;
      padding: 38px 44px;
      border-radius: var(--radius-lg);
      background: white;
      border: 1px solid var(--line);
    }

    .you-card .you-label {
      color: var(--teal-dark);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .you-card p {
      font-size: 1.12rem;
      line-height: 1.75;
    }

    /* =========================================================
       08. PRINCE COURT OVERVIEW
       ========================================================= */

    .pcmc-section {
      background: white;
    }

    .pcmc-hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      min-height: 610px;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--navy);
      box-shadow: var(--shadow-lg);
    }

    .pcmc-image {
      min-height: 610px;
      background:
        linear-gradient(
          0deg,
          rgba(12,47,56,0.28),
          rgba(12,47,56,0.03)
        ),
        url("prince-court-building.jpg") center / cover no-repeat;
    }

    .pcmc-copy {
      padding: clamp(48px, 6vw, 80px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .pcmc-copy .eyebrow {
      color: #a4e5de;
    }

    .pcmc-copy h2 {
      color: white;
      font-size: clamp(2.5rem, 4.4vw, 4.5rem);
    }

    .pcmc-copy > p {
      margin-top: 22px;
      color: rgba(255,255,255,0.72);
      line-height: 1.8;
    }

    .facts-grid {
      margin-top: 34px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .fact {
      padding: 24px;
      background: rgba(13,46,54,0.65);
    }

    .fact-label {
      color: rgba(255,255,255,0.55);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 750;
    }

    .fact-value {
      display: block;
      margin-top: 5px;
      color: white;
      font-size: 1.15rem;
      font-weight: 720;
    }

    .recognition-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 22px;
    }

    .recognition {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 22px 24px;
      border-radius: var(--radius-md);
      background: var(--sand);
      border: 1px solid #ece8de;
    }

    .recognition-icon {
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--teal-soft);
      color: var(--teal-dark);
      font-size: 1.2rem;
    }

    .recognition small {
      display: block;
      color: var(--ink-faint);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      font-weight: 800;
    }

    .recognition strong {
      display: block;
      margin-top: 3px;
      font-size: 0.91rem;
      line-height: 1.35;
    }

    /* =========================================================
       09. POLICIES / SAFETY / COMPLIANCE
       ========================================================= */

    .policy-section {
      background: var(--teal-pale);
    }

    .policy-header {
      display: grid;
      grid-template-columns: 1fr 0.85fr;
      gap: 70px;
      align-items: end;
    }

    .policy-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 54px;
    }

    .policy-card {
      display: grid;
      grid-template-columns: 62px 1fr;
      gap: 22px;
      padding: 30px;
      background: white;
      border-radius: var(--radius-md);
      border: 1px solid rgba(0, 155, 156, 0.1);
    }

    .policy-icon {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      color: var(--teal-dark);
      background: var(--teal-soft);
      font-size: 1.3rem;
    }

    .policy-card h3 {
      font-size: 1.05rem;
      letter-spacing: -0.015em;
    }

    .policy-card p {
      margin-top: 8px;
      font-size: 0.89rem;
      line-height: 1.72;
    }

    .policy-card.highlight {
      background: var(--navy);
      grid-column: 1 / -1;
      color: white;
      border: 0;
    }

    .policy-card.highlight h3 {
      color: white;
    }

    .policy-card.highlight p {
      color: rgba(255,255,255,0.72);
    }

    .policy-card.highlight .policy-icon {
      background: rgba(255,255,255,0.12);
      color: #a5e4dc;
    }

    .stats-ribbon {
      margin-top: 22px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--navy-deep);
    }

    .stat {
      padding: 34px 38px;
      color: white;
    }

    .stat + .stat {
      border-left: 1px solid rgba(255,255,255,0.12);
    }

    .stat-big {
      display: block;
      color: #9de0d9;
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1;
    }

    .stat p {
      margin-top: 9px;
      color: rgba(255,255,255,0.7);
      font-size: 0.86rem;
    }

    /* =========================================================
       10. DAILY WORK LIFE
       ========================================================= */

    .daily-section {
      background: white;
    }

    .daily-grid {
      display: grid;
      grid-template-columns: 0.88fr 1.12fr;
      gap: 70px;
      align-items: start;
    }

    .daily-photo {
      position: sticky;
      top: 40px;
      height: 760px;
      object-fit: cover;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-md);
    }

    .daily-copy {
      padding-top: 16px;
    }

    .work-points {
      margin-top: 42px;
      display: grid;
      gap: 18px;
    }

    .work-point {
      padding: 28px 30px;
      border-radius: var(--radius-md);
      background: var(--sand);
      border: 1px solid #ece8de;
    }

    .work-point-top {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .work-point-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: white;
      color: var(--teal-dark);
    }

    .work-point h3 {
      font-size: 1rem;
    }

    .work-point p {
      margin-top: 12px;
      font-size: 0.91rem;
      line-height: 1.75;
    }

    /* =========================================================
       11. FACILITIES
       ========================================================= */

    .facilities-section {
      background: var(--sand);
    }

    .facility-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 52px;
    }

    .facility-card {
      min-height: 260px;
      display: flex;
      flex-direction: column;
      padding: 30px;
      border-radius: var(--radius-md);
      background: white;
      border: 1px solid #ebe8df;
    }

    .facility-number {
      color: var(--teal);
      font-size: 0.7rem;
      font-weight: 850;
      letter-spacing: 0.12em;
    }

    .facility-icon {
      margin-top: 36px;
      font-size: 1.55rem;
    }

    .facility-card h3 {
      margin-top: auto;
      padding-top: 32px;
      font-size: 1.03rem;
    }

    .facility-card p {
      margin-top: 8px;
      font-size: 0.82rem;
      line-height: 1.6;
    }

    /* =========================================================
       12. GETTING HERE
       ========================================================= */

    .transport-section {
      background: var(--navy-deep);
      color: white;
    }

    .transport-section h2 {
      color: white;
    }

    .transport-section .eyebrow {
      color: #9de0d9;
    }

    .transport-layout {
      display: grid;
      grid-template-columns: 0.78fr 1.22fr;
      gap: 60px;
      align-items: stretch;
    }

    .transport-intro p {
      margin-top: 22px;
      color: rgba(255,255,255,0.67);
      line-height: 1.8;
    }

    .transport-cards {
      display: grid;
      gap: 12px;
    }

    .transport-card {
      display: grid;
