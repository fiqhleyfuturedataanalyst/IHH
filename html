      position: relative;
      padding-left: 20px;
      color: var(--ink-soft);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .benefit-card li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--teal);
    }

