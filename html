      font-size: 0.68rem;
      font-weight: 850;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .transport-card strong {
      color: white;
      font-size: 1rem;
    }

    .transport-card p {
      margin-top: 3px;
      color: rgba(255,255,255,0.58);
      font-size: 0.78rem;
    }

    .transport-time {
      padding: 7px 11px;
      border-radius: 999px;
      background: rgba(157,224,217,0.12);
      color: #b8ebe5;
      font-size: 0.7rem;
      font-weight: 750;
      white-space: nowrap;
