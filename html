      margin-top: 42px;
      display: inline-flex;
      padding: 14px 20px;
      border-radius: 999px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.16);
      color: white;
      font-weight: 700;
    }

    /* =========================================================
       16. FOOTER
       ========================================================= */

    .footer {
      padding: 42px 0;
      background: #071f25;
      color: white;
    }

    .footer-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 40px;
      align-items: center;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .footer-brand img {
      width: auto;
      height: 36px;
      object-fit: contain;
    }

    .footer-note {
      color: rgba(255,255,255,0.46);
      font-size: 0.68rem;
      line-height: 1.6;
      text-align: right;
    }

    /* =========================================================
       17. RESPONSIVE
       ========================================================= */

    @media (max-width: 980px) {
      .welcome-grid,
      .pcmc-hero,
      .daily-grid,
      .transport-layout,
      .career-layout,
      .values-header,
      .policy-header {
        grid-template-columns: 1fr;
      }

      .values-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .facility-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .daily-photo {
        position: relative;
        top: auto;
        height: 520px;
      }

      .welcome-photo {
        height: 520px;
      }

      .photo-tag {
        right: 20px;
      }

      .pcmc-image {
        min-height: 440px;
      }
    }

    @media (max-width: 700px) {
      .container {
        width: min(calc(100% - 30px), var(--page));
      }

      .brand-lockup .brand-divider,
      .brand-lockup .brand-logo--pcmc,
      .guide-label {
        display: none;
      }

      .hero-content {
        padding-bottom: 55px;
      }

      .hero-footer {
        flex-direction: column;
        align-items: flex-start;
      }

      .edition {
        text-align: left;
      }

      .purpose-cards,
      .policy-grid,
      .benefits-grid,
      .recognition-strip,
      .stats-ribbon {
        grid-template-columns: 1fr;
      }

      .values-grid,
      .facility-grid {
        grid-template-columns: 1fr;
      }

      .you-card {
        grid-template-columns: 1fr;
      }

      .policy-card.highlight {
        grid-column: auto;
      }

      .stat + .stat {
        border-left: 0;
        border-top: 1px solid rgba(255,255,255,0.12);
      }

      .transport-card {
        grid-template-columns: 58px 1fr;
      }

      .transport-time {
        grid-column: 2;
        justify-self: start;
      }

      .footer-row {
        grid-template-columns: 1fr;
      }

      .footer-note {
        text-align: left;
      }
    }

